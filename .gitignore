__pycache__/
*.pyc
*.pyo
*.egg-info/
logs/
*.log
.venv/
venv/
# macOS 开发用的环境；Windows 上重建
.venv-macos/
.vscode/
.idea/
.DS_Store
.claude/
dist/
build/
# Inno Setup 的产物目录（由 CI 或 build_installer.ps1 生成）
release/
*.egg
# 编辑前留下的临时备份
*.bak-*
runtime_config*.json
!runtime_config.example.json
certs/
spool/
script_bundle/runtime_config*.json
script_bundle/certs/
script_bundle/spool/
# The per-installation template overrides.  Anchored to the root on purpose:
# a bare name would also match templates/receipt_template.json, which is the
# tracked shipped default and must be in Git.
/receipt_template.json
/kitchen_template.json
*.json.bak
*.json.tmp
*.json.invalid
*.qmlc
*.jsc
# PowerShell 意外生成的空文件

*.broken

# Redsys payment terminal: the live signing key and the transaction store are
# per-installation state, like certs/ and spool/.  config.example.yaml ships
# instead and is copied to config.yaml by the installer.
/redsys/config.yaml
/redsys/data/
